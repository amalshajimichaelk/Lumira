# ============================================================
# MediMetrics Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# ============================================================

# ------------------------------------
# Server
# ------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------
# Database (from Render Managed PostgreSQL)
# ------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/mediMetrics?schema=public

# ------------------------------------
# JWT Secrets — use long random strings (32+ chars)
# ------------------------------------
JWT_ACCESS_SECRET=your-long-random-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-long-random-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------
# CORS — comma-separated list of allowed origins
# ------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------
# Cookie Settings
# ------------------------------------
COOKIE_SECURE=false
# Set to true in production (HTTPS only)
COOKIE_DOMAIN=localhost
# Set to .onrender.com in production
